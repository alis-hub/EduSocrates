APP_NAME=EduSocrates Platform
NODE_ENV=development

# Postgres (Docker Compose)
DATABASE_URL=postgresql://edusocrates:socrates_password@localhost:5432/edusocrates_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=super-secret-edusocrates-jwt-key-change-in-prod
JWT_EXPIRES_IN=1d

# API Gateway
API_PORT=3000

# AI Gateway
AI_GATEWAY_URL=http://localhost:8000
AI_GATEWAY_API_KEY=edusocrates-internal-gateway-key

# LLM Provider: "mock" | "gemini" | "openai"
DEFAULT_PROVIDER=mock

# Optional — add your API key here to use real LLM
GEMINI_API_KEY=
OPENAI_API_KEY=

