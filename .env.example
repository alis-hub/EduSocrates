APP_NAME=GuruMera Platform
NODE_ENV=development
# "production" makes both gateways refuse weak/missing secrets and disables demo mode and API docs.
APP_ENV=development

# Generate secrets with:  openssl rand -hex 32   (never reuse these examples)
# ── Postgres ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me
# Owner/system connection (migrations, auth lookups, platform admin)
DATABASE_URL=postgresql://edusocrates:change-me@localhost:5432/edusocrates_dev
# Restricted role used for tenant data; enforces row-level security (created by migration 004)
APP_DB_PASSWORD=change-me-too
DATABASE_APP_URL=postgresql://gurumera_app:change-me-too@localhost:5432/edusocrates_dev

# ── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth ───────────────────────────────────────────────────────────────────
# At least 32 random characters. The API refuses to start without one.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Google sign-in: OAuth client ID. Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:3001
# Leave empty for localhost. In production set to .gurumera.com so web and api share the session cookie
COOKIE_DOMAIN=
# Set to 1 when behind a single reverse proxy so rate limits see the real client IP
TRUST_PROXY=
# Demo logins / demo reset. Ignored when NODE_ENV=production.
ENABLE_DEMO_MODE=false

# ── API Gateway ────────────────────────────────────────────────────────────
API_PORT=3000

# ── AI Gateway (internal service) ──────────────────────────────────────────
AI_GATEWAY_URL=http://localhost:8000
# Shared secret between API gateway and AI gateway (32+ random characters)
AI_GATEWAY_API_KEY=
# Encrypts chat history stored in Redis (32+ random characters)
AES_ENCRYPTION_KEY=
# Daily cap on public-hub AI calls across all anonymous + free users
HUB_GLOBAL_DAILY_AI_LIMIT=3000
# AI cost caps (messages). Per student per hour, per school per day, per tutor/academy per day.
STUDENT_HOURLY_AI_LIMIT=40
SCHOOL_DAILY_AI_LIMIT=6000
TUTOR_DAILY_AI_LIMIT=1500

# Email (Brevo transactional API). Leave BREVO_API_KEY empty in development: emails are printed to the server log instead.
BREVO_API_KEY=
EMAIL_FROM=no-reply@gurumera.com
EMAIL_FROM_NAME=GuruMera
EMAIL_REPLY_TO=info@gurumera.com
# Public address of the web app, used for links inside emails
APP_BASE_URL=http://localhost:3001

# LLM Provider: "mock" | "gemini" | "openai"
DEFAULT_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# ── Web app (public values; baked in at build time) ────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Same Google OAuth client ID as GOOGLE_CLIENT_ID above; leave empty to hide Google sign-in.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Shows the demo logins on the login page. Only for demo builds; never in production.
NEXT_PUBLIC_ENABLE_DEMO=false
